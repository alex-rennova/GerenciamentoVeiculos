@page "/veiculos"
@inject IVeiculoHttpService VeiculoService
@inject IProprietarioHttpService ProprietarioService

<PageTitle>Veículos - AutoGestão .NET</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">🚘 Gestão de Veículos</h2>
            <p class="text-muted mb-0">Pesquise, filtre e cadastre veículos vinculados a seus respectivos proprietários.</p>
        </div>
        <button class="btn btn-success" @onclick="AbrirModalNovo">
            ➕ Novo Veículo
        </button>
    </div>

    <!-- Mensagens de Feedback -->
    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">⚡</span>
                <div>
                    <strong>Sucesso!</strong> @mensagemSucesso
                    <div class="small text-muted mt-1">
                        Mensagem publicada na <strong>Fila da Azure</strong> e processada pelo <strong>Background Worker</strong> da API.
                    </div>
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Erro na Operação:</strong> @mensagemErro
            <button type="button" class="btn-close" @onclick="() => mensagemErro = null"></button>
        </div>
    }

    <!-- Barra de Filtros de Pesquisa Obrigatória -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 bg-light rounded-3">
            <h6 class="fw-bold text-dark mb-3">🔍 Filtros de Busca (Placa, Modelo ou Proprietário)</h6>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Placa</label>
                    <input type="text" class="form-control" placeholder="Ex: SEN, BRA..." @bind="filtroPlaca" @bind:event="oninput" @onkeyup="FiltrarVeiculos" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Modelo</label>
                    <input type="text" class="form-control" placeholder="Ex: McLaren, Civic..." @bind="filtroModelo" @bind:event="oninput" @onkeyup="FiltrarVeiculos" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Nome do Proprietário</label>
                    <input type="text" class="form-control" placeholder="Ex: Senna, Rubens..." @bind="filtroProprietario" @bind:event="oninput" @onkeyup="FiltrarVeiculos" />
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="LimparFiltros">
                        Limpar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Veículos -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (carregando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted mt-2 mb-0">Consultando veículos...</p>
                </div>
            }
            else if (!veiculos.Any())
            {
                <div class="text-center py-5 text-muted">
                    <p class="fs-5 mb-1">Nenhum veículo encontrado para os critérios selecionados.</p>
                    <small>Tente ajustar os filtros ou cadastre um novo veículo.</small>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Placa</th>
                                <th>Modelo</th>
                                <th>Ano</th>
                                <th>Proprietário Vinculado</th>
                                <th class="text-end pe-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in veiculos)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-dark text-warning border px-2 py-1 fs-6 font-monospace" style="letter-spacing: 1px;">
                                            @v.Placa
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@v.Modelo</div>
                                        <span class="text-muted small">Id: @v.Id</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@v.Ano</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-primary">@v.NomeProprietario</div>
                                        <span class="text-muted small">Id: @v.ProprietarioId</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => AbrirModalEditar(v)">
                                            ✏️ Editar
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => SolicitarExclusao(v)">
                                            🗑️ Excluir
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de Cadastro / Edição de Veículo -->
@if (exibirModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">@(modoEdicao ? "Editar Veículo" : "Cadastrar Novo Veículo")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalErro))
                    {
                        <div class="alert alert-danger small mb-3">
                            @modalErro
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Proprietário (Obrigatório)</label>
                        <select class="form-select" @bind="formProprietarioId">
                            <option value="@Guid.Empty">-- Selecione o Proprietário --</option>
                            @foreach (var p in listaProprietarios)
                            {
                                <option value="@p.Id">@p.Nome (@p.CpfFormatado)</option>
                            }
                        </select>
                        <div class="form-text">Ao cadastrar, a API valida se o proprietário existe.</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Placa (Tradicional ou Mercosul)</label>
                            <input type="text" class="form-control text-uppercase font-monospace" @bind="formPlaca" placeholder="ABC-1234 ou ABC1D23" maxlength="8" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ano de Fabricação (> 1980)</label>
                            <input type="number" class="form-control" @bind="formAno" min="1981" max="@(DateTime.UtcNow.Year + 1)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Modelo do Veículo</label>
                        <input type="text" class="form-control" @bind="formModelo" placeholder="Ex: Honda Civic Touring" maxlength="80" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="SalvarVeiculo" disabled="@salvando">
                        @if (salvando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Salvar e Enviar à Fila
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmação de Exclusão -->
@if (veiculoParaExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => veiculoParaExcluir = null"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0">Deseja realmente remover o veículo <strong>@veiculoParaExcluir.Modelo (@veiculoParaExcluir.Placa)</strong>?</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => veiculoParaExcluir = null">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao" disabled="@salvando">
                        @if (salvando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Excluir Veículo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<VeiculoRespostaDto> veiculos = new();
    private List<ProprietarioRespostaDto> listaProprietarios = new();
    private bool carregando = true;
    private bool salvando = false;
    private string? mensagemSucesso;
    private string? mensagemErro;
    private string? modalErro;

    // Filtros
    private string? filtroPlaca;
    private string? filtroModelo;
    private string? filtroProprietario;

    // Modal
    private bool exibirModal = false;
    private bool modoEdicao = false;
    private Guid? veiculoEditandoId;
    private string formPlaca = string.Empty;
    private string formModelo = string.Empty;
    private int formAno = DateTime.UtcNow.Year;
    private Guid formProprietarioId = Guid.Empty;

    // Exclusão
    private VeiculoRespostaDto? veiculoParaExcluir;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CarregarVeiculos(), CarregarProprietariosCombo());
    }

    private async Task CarregarVeiculos()
    {
        carregando = true;
        try
        {
            veiculos = await VeiculoService.ObterComFiltroAsync(filtroPlaca, filtroModelo, filtroProprietario);
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarProprietariosCombo()
    {
        try
        {
            listaProprietarios = await ProprietarioService.ObterTodosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar proprietários no combo: {ex.Message}");
        }
    }

    private async Task FiltrarVeiculos()
    {
        await CarregarVeiculos();
    }

    private async Task LimparFiltros()
    {
        filtroPlaca = null;
        filtroModelo = null;
        filtroProprietario = null;
        await CarregarVeiculos();
    }

    private async Task AbrirModalNovo()
    {
        modoEdicao = false;
        veiculoEditandoId = null;
        formPlaca = string.Empty;
        formModelo = string.Empty;
        formAno = DateTime.UtcNow.Year;
        formProprietarioId = listaProprietarios.FirstOrDefault()?.Id ?? Guid.Empty;
        modalErro = null;
        await CarregarProprietariosCombo();
        exibirModal = true;
    }

    private async Task AbrirModalEditar(VeiculoRespostaDto v)
    {
        modoEdicao = true;
        veiculoEditandoId = v.Id;
        formPlaca = v.Placa;
        formModelo = v.Modelo;
        formAno = v.Ano;
        formProprietarioId = v.ProprietarioId;
        modalErro = null;
        await CarregarProprietariosCombo();
        exibirModal = true;
    }

    private void FecharModal()
    {
        exibirModal = false;
        modalErro = null;
    }

    private async Task SalvarVeiculo()
    {
        modalErro = null;
        mensagemSucesso = null;
        mensagemErro = null;

        if (formProprietarioId == Guid.Empty)
        {
            modalErro = "Selecione um proprietário válido para o veículo.";
            return;
        }

        salvando = true;

        try
        {
            if (modoEdicao && veiculoEditandoId.HasValue)
            {
                var dto = new VeiculoAtualizacaoDto(formPlaca, formModelo, formAno, formProprietarioId);
                var (sucesso, erro) = await VeiculoService.AtualizarAsync(veiculoEditandoId.Value, dto);
                if (sucesso)
                {
                    mensagemSucesso = "Veículo atualizado com sucesso!";
                    FecharModal();
                    await CarregarVeiculos();
                }
                else
                {
                    modalErro = erro;
                }
            }
            else
            {
                var dto = new VeiculoCriacaoDto(formPlaca, formModelo, formAno, formProprietarioId);
                var (sucesso, erro) = await VeiculoService.CriarAsync(dto);
                if (sucesso)
                {
                    mensagemSucesso = $"Veículo '{formModelo}' ({formPlaca.ToUpper()}) cadastrado com sucesso!";
                    FecharModal();
                    await CarregarVeiculos();
                }
                else
                {
                    modalErro = erro;
                }
            }
        }
        finally
        {
            salvando = false;
        }
    }

    private void SolicitarExclusao(VeiculoRespostaDto v)
    {
        veiculoParaExcluir = v;
    }

    private async Task ConfirmarExclusao()
    {
        if (veiculoParaExcluir == null) return;

        mensagemSucesso = null;
        mensagemErro = null;
        salvando = true;

        try
        {
            var (sucesso, erro) = await VeiculoService.ExcluirAsync(veiculoParaExcluir.Id);
            if (sucesso)
            {
                mensagemSucesso = $"Veículo '{veiculoParaExcluir.Modelo}' excluído com sucesso!";
                veiculoParaExcluir = null;
                await CarregarVeiculos();
            }
            else
            {
                mensagemErro = erro;
                veiculoParaExcluir = null;
            }
        }
        finally
        {
            salvando = false;
        }
    }
}
