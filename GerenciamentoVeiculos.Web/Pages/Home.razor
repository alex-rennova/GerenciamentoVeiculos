@page "/"
@inject IProprietarioHttpService ProprietarioService
@inject IVeiculoHttpService VeiculoService

<PageTitle>Dashboard - Gerenciamento de Veículos</PageTitle>

<div class="container-fluid">
    <!-- Banner de Destaque para a Plataforma de Treinamento -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 p-md-5 bg-gradient text-white rounded-3 shadow" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <span class="badge bg-warning text-dark font-monospace px-3 py-1 mb-2 fs-6">NOVO • TREINADOR LIVE CODING .NET SÊNIOR</span>
                        <h1 class="display-6 fw-bold mb-2">Simulador & Preparatório Técnico Live Code</h1>
                        <p class="lead text-white-50 mb-3">
                            Acesse a plataforma de estudo interativa com <strong>12 Módulos explicados linha por linha</strong>, <strong>Simulador Visual de Debugging</strong>, <strong>Treinador de Fala</strong> e <strong>Modo Entrevista Real com cronômetro</strong>.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="treinamento" class="btn btn-warning btn-lg fw-bold text-dark px-4 shadow">
                                🎓 Abrir Plataforma de Treinamento &rarr;
                            </a>
                            <a href="http://localhost:5000" target="_blank" class="btn btn-outline-light btn-lg px-3">
                                📄 Swagger da API
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center d-none d-lg-block">
                        <span style="font-size: 6rem;">⚡</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (carregando)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando métricas...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Cards de Estatísticas -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-primary text-white h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 text-uppercase fw-bold mb-1">Proprietários</h6>
                                <h2 class="display-5 fw-bold mb-0">@totalProprietarios</h2>
                            </div>
                            <span class="fs-1 opacity-75">👥</span>
                        </div>
                        <div class="mt-3">
                            <a href="proprietarios" class="text-white text-decoration-none small fw-semibold">
                                Gerenciar proprietários &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success text-white h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 text-uppercase fw-bold mb-1">Veículos Cadastrados</h6>
                                <h2 class="display-5 fw-bold mb-0">@totalVeiculos</h2>
                            </div>
                            <span class="fs-1 opacity-75">🚘</span>
                        </div>
                        <div class="mt-3">
                            <a href="veiculos" class="text-white text-decoration-none small fw-semibold">
                                Gerenciar veículos &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-dark text-white h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 text-uppercase fw-bold mb-1">Mensageria Azure</h6>
                                <h4 class="fw-bold mb-0 text-info">Ativa & Conectada</h4>
                            </div>
                            <span class="fs-1 opacity-75">⚡</span>
                        </div>
                        <p class="text-white-50 small mt-2 mb-0">
                            Worker em segundo plano integrado processando eventos de novos veículos.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Painel Explicativo Didático -->
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold">🎯 Regras de Negócio Implementadas</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex align-items-start">
                                <span class="badge bg-success rounded-pill me-3 mt-1">✔</span>
                                <div>
                                    <strong>Cálculo Real de CPF:</strong>
                                    Validação matemática dos dois dígitos verificadores e rejeição de sequências repetidas.
                                </div>
                            </li>
                            <li class="list-group-item d-flex align-items-start">
                                <span class="badge bg-success rounded-pill me-3 mt-1">✔</span>
                                <div>
                                    <strong>Bloqueio de Exclusão (409 Conflict):</strong>
                                    Impossível excluir proprietários que possuem veículos vinculados.
                                </div>
                            </li>
                            <li class="list-group-item d-flex align-items-start">
                                <span class="badge bg-success rounded-pill me-3 mt-1">✔</span>
                                <div>
                                    <strong>Validação de Existência do Proprietário:</strong>
                                    Ao cadastrar veículo, valida se o proprietário selecionado existe no sistema.
                                </div>
                            </li>
                            <li class="list-group-item d-flex align-items-start">
                                <span class="badge bg-success rounded-pill me-3 mt-1">✔</span>
                                <div>
                                    <strong>Formatos de Placa:</strong>
                                    Suporte simultâneo ao padrão tradicional (<code>ABC-1234</code>) e padrão Mercosul (<code>ABC1D23</code>).
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold">🛠️ Tecnologias e Padrões Aplicados</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-secondary p-2">.NET 8</span>
                            <span class="badge bg-secondary p-2">C# 12</span>
                            <span class="badge bg-secondary p-2">Blazor WebAssembly</span>
                            <span class="badge bg-secondary p-2">Clean Architecture</span>
                            <span class="badge bg-secondary p-2">EF Core InMemory</span>
                            <span class="badge bg-secondary p-2">FluentValidation</span>
                            <span class="badge bg-secondary p-2">Azure Service Bus</span>
                            <span class="badge bg-secondary p-2">Background Worker</span>
                            <span class="badge bg-secondary p-2">Swagger / OpenAPI</span>
                            <span class="badge bg-secondary p-2">xUnit & Moq</span>
                        </div>
                        <p class="text-muted small">
                            A aplicação frontend Blazor comunica-se com a Web API utilizando injeção de dependência via <code>HttpClient</code>, tratando automaticamente os retornos padronizados no formato <strong>RFC 7807 (ProblemDetails)</strong>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool carregando = true;
    private int totalProprietarios = 0;
    private int totalVeiculos = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var proprietarios = await ProprietarioService.ObterTodosAsync();
            totalProprietarios = proprietarios.Count;

            var veiculos = await VeiculoService.ObterComFiltroAsync();
            totalVeiculos = veiculos.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar métricas: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }
}
